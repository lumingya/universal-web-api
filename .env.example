# ======================================
# Universal Web-to-API 配置文件
# ======================================

# ========== 版本信息 ==========
# ⚠️ CURRENT_VERSION 后端不读取：版本号实际读自项目根目录的 VERSION 文件（app/__init__.py）。
# 在此处修改无任何效果，保留仅作说明。
# CURRENT_VERSION=1.01

# ========== 自动更新配置 ==========
# 是否启用自动更新（true/false）
AUTO_UPDATE_ENABLED=true

# GitHub 仓库地址（用于检查更新）
GITHUB_REPO=lumingya/universal-web-api

# ⚠️ UPDATE_PRESERVE 后端不读取：更新保留白名单实际存放在 config/update_settings.json，
# 请在控制面板「设置 → 更新保留」里配置。
# UPDATE_PRESERVE=chrome_profile,venv,.env.local,logs

# ========== 服务配置 ==========
# 监听地址（0.0.0.0 允许外部访问，127.0.0.1 仅本地）
APP_HOST=127.0.0.1

# 监听端口
APP_PORT=8199

# 调试模式（true 开启 API 文档和详细错误）
APP_DEBUG=true

# 日志级别（DEBUG, INFO, WARNING, ERROR）
LOG_LEVEL=DEBUG
# ========== 认证配置 ==========
# 是否启用 API 认证
AUTH_ENABLED=false

# Bearer Token（AUTH_ENABLED=true 时必须设置）
AUTH_TOKEN=

# ========== CORS 配置 ==========
# 是否启用 CORS
CORS_ENABLED=true

# 允许的跨域源
CORS_ORIGINS=*

# ========== 浏览器配置 ==========
# Chrome 远程调试端口
BROWSER_PORT=9222

# ========== Dashboard 配置 ==========
DASHBOARD_ENABLED=true
DASHBOARD_FILE=static/index.html

# ========== AI 分析配置 ==========
HELPER_API_KEY=your-api-key-here
HELPER_BASE_URL=http://127.0.0.1:8199/url/gemini.com/v1
# API 提供商类型（auto=自动检测, openai=OpenAI兼容, gemini=Gemini官方, claude=Claude官方）
HELPER_API_PROVIDER=auto
HELPER_MODEL=gemini-3.0-pro
MAX_HTML_CHARS=120000
CANVAS_IMAGE_MAX_SIZE=1024

# ========== 配置文件 ==========
SITES_CONFIG_FILE=config/sites.json

# 自定义浏览器路径（可选，留空则自动检测 Chrome/Edge/Brave 等）
# BROWSER_PATH=
# 浏览器配置目录（留空则使用项目内 chrome_profile）
# BROWSER_PROFILE_DIR=
# Chrome 配置名称（常见值：Default、Profile 1）
# BROWSER_PROFILE_NAME=
# 解析路径
PUBLIC_BASE_URL=http://127.0.0.1:8199
# ===== 代理配置 =====
# 是否启用代理 (true/false)
PROXY_ENABLED=false
# 代理地址 (支持 socks5:// 或 http://)
# 示例: socks5://127.0.0.1:1080 或 http://127.0.0.1:7890
PROXY_ADDRESS=socks5://127.0.0.1:1080
# 不走代理的地址 (逗号分隔)
PROXY_BYPASS=localhost,127.0.0.1

TOOL_CALLING_RETRY_STRATEGY=focused_repair
TOOL_CALLING_INTERNAL_RETRY_MAX=2
TOOL_CALLING_MAX_TOOL_RESULT_CHARS=300000

PROFILE_CLEAN_ENABLED=true

TOOL_CALLING_ALLOW_MEDIA_POSTPROCESS=false
TOOL_CALLING_SANITIZE_ASSISTANT_CONTENT=true

PYTHON_INSTALL_VERSION=3.13.6
TOOL_CALLING_PROMPT_PADDING_OBFUSCATE=false
TOOL_CALLING_PROMPT_PADDING_ENABLED=true

# ========== Ngrok 内网穿透配置 ==========
# ⚠️ 以下 Ngrok 变量当前版本尚未实现，配置了也不会生效（包括 Basic Auth 密码保护）。保留在此仅作后续规划参考。
# 您的 Ngrok Authtoken (从 https://dashboard.ngrok.com/get-started/your-authtoken 获取)
# NGROK_AUTHTOKEN=

# 您的 Ngrok 静态域名 (例如: xxx-yyy-zzz.ngrok-free.app)
# NGROK_STATIC_DOMAIN=vertical-smolder-purely.ngrok-free.dev

# 内网穿透安全访问设置 - Basic Auth 账号（未实现，填写也不会有密码保护）
# NGROK_AUTH_USER=

# 内网穿透安全访问设置 - Basic Auth 密码（未实现，填写也不会有密码保护）
# NGROK_AUTH_PASSWORD=

DASHBOARD_AUTH_ENABLED=false
DASHBOARD_AUTH_TOKEN=

# ⚠️ 安全警告：设为 true 会跳过 Python 沙箱校验，并以完整 __builtins__ 执行命令里的任意脚本
#（可读写任意文件、执行任意系统命令）。后端默认 false，仅在配置完全可信时才临时开启。
CMD_ALLOW_UNSAFE_PYTHON_COMMANDS=false

# ========== 错误标签页 AI 恢复配置 ==========
# 标签页 BUSY 超时被标记 ERROR 并移出池后，其底层标签页会先进入"隔离集合"：
# 隔离机制始终生效（与 TAB_RECOVERY_ENABLED 无关），在确认旧请求的工作线程
# 退出前，扫描不会把该标签页重新入池，避免新旧请求并发驱动同一页面。
# 是否启用 AI 恢复判断（false 时：旧工作线程退出后直接解除隔离、自动重入池，
# 不截图、不调用任何 AI API，即保持原有行为但消除了串扰）
TAB_RECOVERY_ENABLED=false
# AI 判断使用的 OpenAI 兼容 chat/completions 完整接口地址。
# 留空 = 本地模式：调用本服务自身的 http://127.0.0.1:{APP_PORT}/v1/chat/completions，
# 用池中其他空闲标签页完成判断（鉴权自动复用 AUTH_ENABLED/AUTH_TOKEN，无需额外配置）
TAB_RECOVERY_API_URL=
# 外部 API 的 Bearer Key（仅 TAB_RECOVERY_API_URL 非空时使用）
TAB_RECOVERY_API_KEY=
# 判断使用的模型名（需支持图片输入）
TAB_RECOVERY_MODEL=gpt-4o
# 每个标签页最多允许成功恢复的次数：恢复后再次超时错误即视为不可恢复，
# 永久隔离且不再调用 AI API（默认 1 次）
TAB_RECOVERY_MAX_ATTEMPTS=1
# AI 判断请求超时（秒）。本地模式要经过完整浏览器往返，不建议设置过短
TAB_RECOVERY_TIMEOUT_SEC=120
# 等待旧工作线程退出的最长时间（秒），超时仍未退出则永久隔离该标签页
TAB_RECOVERY_WORKER_EXIT_WAIT_SEC=600
# 截图/AI 调用/解析失败等"无法判断"时是否仍尝试刷新恢复
# （true=刷新后重入池，false=直接永久隔离）
TAB_RECOVERY_REFRESH_ON_UNKNOWN=true
