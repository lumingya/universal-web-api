# ======================================
# Universal Web-to-API 配置文件模板
# ======================================
# 用法：复制为 .env 后按需修改。
#
# 安全须知（务必先读）：
#   1. 本模板的默认值按「单机本地使用」设计：只监听回环地址、不开放跨源。
#   2. 布尔项必须写 true / false。写成占位符（例如 your-secret-here）会被视为
#      配置错误，服务将拒绝启动，而不是静默把认证关掉。
#   3. 只要把 APP_HOST 改成 0.0.0.0 或任何对外地址，就必须同时设置
#      DASHBOARD_AUTH_ENABLED=true 和一个强 DASHBOARD_AUTH_TOKEN，否则启动会被拒绝。
#   4. 本服务会驱动你已登录的浏览器，并可执行自定义 Python/JS 命令。
#      它等价于一个远程控制台，不要暴露到公网或不可信局域网。

# ========== 版本信息 ==========
# 当前版本（自动更新时会修改）
CURRENT_VERSION=1.01

# ========== 自动更新配置 ==========
# 是否启用自动更新（true/false）
AUTO_UPDATE_ENABLED=true

# GitHub 仓库地址（用于检查更新）
GITHUB_REPO=lumingya/universal-web-api

# 更新时保留的文件/目录（逗号分隔）
UPDATE_PRESERVE=chrome_profile,venv,.env.local,logs

# ========== 服务配置 ==========
# 监听地址。127.0.0.1 = 仅本机（推荐）；0.0.0.0 = 对外开放，必须配合管理令牌。
APP_HOST=127.0.0.1

# 监听端口
APP_PORT=8199

# 调试模式（true 会开放 /docs 并返回详细错误，仅本地排障时开启）
APP_DEBUG=false

# 日志级别（DEBUG, INFO, WARNING, ERROR）
# 生产环境建议 INFO：DEBUG 会在每次轮询/网络事件上格式化并写出大量日志（CPU 开销明显）
LOG_LEVEL=INFO

# ========== 认证配置 ==========
# 对外服务接口（/v1/chat/completions 等）的认证开关，只能填 true / false
AUTH_ENABLED=false

# Bearer Token（AUTH_ENABLED=true 时必须设置一个强随机值）
# 生成方式示例：python -c "import secrets;print(secrets.token_urlsafe(32))"
AUTH_TOKEN=

# 控制面板与管理接口的认证开关，只能填 true / false
# 留空表示沿用 AUTH_ENABLED。非本机访问时必须为 true。
DASHBOARD_AUTH_ENABLED=false

# 控制面板令牌。强烈建议与 AUTH_TOKEN 使用**不同**的强随机值。
DASHBOARD_AUTH_TOKEN=

# 修复 S4：/api/browser/open-profile-url 过去只检查「连接来源是回环」。
# 本机反向代理或隧道会把外来请求以回环地址转交进来，该检查形同虚设，
# 因此现在带任何转发头（X-Forwarded-For / Forwarded / X-Real-IP ...）的请求一律拒绝，
# 并且在配置了 DASHBOARD_AUTH_TOKEN 时要求出示该令牌。
# 若 Link Drawer 用户脚本无法携带令牌，可用下面这项保留「本机免认证」：
BROWSER_OPEN_URL_ALLOW_UNAUTHENTICATED_LOCAL=false
# 默认拒绝打开指向内网 / 本机 / 云元数据地址的链接（这些链接会带着你浏览器里的 Cookie 打开）。
BROWSER_OPEN_URL_ALLOW_INTERNAL_TARGETS=false

# ========== CORS 配置 ==========
# 控制面板与 API 由同一个服务提供，属于同源请求，通常不需要放开 CORS。
CORS_ENABLED=true

# 允许的跨域来源（逗号分隔的确切来源，例如 https://app.example.com）。
# 留空 = 只放行本机同端口来源（默认，安全）。
# 不要填 * ：那会让任意第三方网页跨源读写你的管理接口。
CORS_ORIGINS=

# ========== 浏览器配置 ==========
# Chrome 远程调试端口
BROWSER_PORT=9222

# 自定义浏览器路径（可选，留空则自动检测 Chrome/Edge/Brave 等）
# BROWSER_PATH=
# 浏览器配置目录（留空则使用项目内 chrome_profile）
# BROWSER_PROFILE_DIR=
# Chrome 配置名称（常见值：Default、Profile 1）
# BROWSER_PROFILE_NAME=

# ========== Dashboard 配置 ==========
DASHBOARD_ENABLED=true
DASHBOARD_FILE=static/index.html

# ========== AI 分析配置 ==========
# 可选：用于页面结构分析的辅助模型。留空则关闭该功能。
HELPER_API_KEY=
HELPER_BASE_URL=
# API 提供商类型（auto=自动检测, openai=OpenAI兼容, gemini=Gemini官方, claude=Claude官方）
HELPER_API_PROVIDER=auto
HELPER_MODEL=
MAX_HTML_CHARS=120000
CANVAS_IMAGE_MAX_SIZE=1024

# ========== 配置文件 ==========
SITES_CONFIG_FILE=config/sites.json

# 对外可访问的基地址（生成媒体/图片链接时使用）
PUBLIC_BASE_URL=http://127.0.0.1:8199

# ========== 代理配置 ==========
# 是否启用代理 (true/false)
PROXY_ENABLED=false
# 代理地址 (支持 socks5:// 或 http://)
# 示例: socks5://127.0.0.1:1080 或 http://127.0.0.1:7890
PROXY_ADDRESS=
# 不走代理的地址 (逗号分隔)
PROXY_BYPASS=localhost,127.0.0.1,::1

# ========== 工具调用 ==========
TOOL_CALLING_RETRY_STRATEGY=focused_repair
TOOL_CALLING_INTERNAL_RETRY_MAX=2
TOOL_CALLING_MAX_TOOL_RESULT_CHARS=300000
TOOL_CALLING_ALLOW_MEDIA_POSTPROCESS=false
TOOL_CALLING_SANITIZE_ASSISTANT_CONTENT=true
TOOL_CALLING_PROMPT_PADDING_OBFUSCATE=false
TOOL_CALLING_PROMPT_PADDING_ENABLED=true

PROFILE_CLEAN_ENABLED=true
PYTHON_INSTALL_VERSION=3.13.6

# ========== 自定义命令执行 ==========
# 允许执行未经 AST 过滤的 Python 命令（可获得平滑鼠标轨迹和物理点击）。
# 警告：开启后自定义命令等同于在本机以当前用户权限任意执行代码。
# 只有当命令全部由你本人编写、且服务没有对外开放时才可设为 true。
CMD_ALLOW_UNSAFE_PYTHON_COMMANDS=false

# ========== Ngrok 内网穿透配置 ==========
# 警告：内网穿透会把本服务暴露到公网。启用前必须先设置 DASHBOARD_AUTH_TOKEN，
# 并同时配置下面的 Basic Auth 账号密码。
# 您的 Ngrok Authtoken (从 https://dashboard.ngrok.com/get-started/your-authtoken 获取)
NGROK_AUTHTOKEN=

# 您的 Ngrok 静态域名 (例如: example-static-domain.ngrok-free.app)
NGROK_STATIC_DOMAIN=

# Basic Auth 账号（留空则不启用密码保护）
NGROK_AUTH_USER=

# Basic Auth 密码（建议设置一个强密码，留空则不启用密码保护）
NGROK_AUTH_PASSWORD=

# ========== 定时重启 ==========
# 定时重启浏览器。空闲标签页的 CDP 会话回收（BROWSER_CDP_RECYCLE_*）已能释放
# 被钉住的旧 DOM / RemoteObject，一般无需再定时重启；需要时再手动开启。
SCHEDULED_RESTART_ENABLED=false
SCHEDULED_RESTART_INTERVAL_SECONDS=10800
SCHEDULED_RESTART_DRAIN_TIMEOUT_SECONDS=1800
SCHEDULED_RESTART_TAB_STATE_POLICY=preserve