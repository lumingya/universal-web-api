# ======================================
# Universal Web-to-API 配置文件模板
# ======================================
# 复制为 .env 后按需修改；本模板的默认值即可安全地在本机直接使用。
# 布尔项只接受 true / false（也接受 1/0、yes/no、on/off）。
# 认证开关写成其它值（例如 your-secret-here）会被视为配置错误并拒绝启动。

# ========== 版本信息 ==========
# 当前版本（自动更新时会修改）
CURRENT_VERSION=1.01

# ========== 自动更新配置 ==========
# 是否启用自动更新（true/false）
AUTO_UPDATE_ENABLED=true

# GitHub 仓库地址（用于检查更新）
GITHUB_REPO=lumingya/universal-web-api

# 更新时保留的文件/目录（逗号分隔）
UPDATE_PRESERVE=chrome_profile,venv,.env.local,logs

# ========== 服务配置 ==========
# 监听地址：127.0.0.1 仅本机可访问（推荐）。
# 改为 0.0.0.0 或局域网地址会把控制面板和 API 暴露给其他设备，
# 此时必须同时启用下方的 AUTH_* 与 DASHBOARD_AUTH_*，否则服务会拒绝启动。
APP_HOST=127.0.0.1

# 监听端口
APP_PORT=8199

# 调试模式（true 会开放 /docs API 文档和详细错误，仅建议本机调试时开启）
APP_DEBUG=false

# 日志级别（DEBUG, INFO, WARNING, ERROR）
# 生产环境建议 INFO：DEBUG 会在每次轮询/网络事件上格式化并写出大量日志（CPU 开销明显）
LOG_LEVEL=INFO

# ========== 认证配置 ==========
# /v1 对外 API 认证。仅本机使用可保持 false；对外监听时必须为 true 并设置 AUTH_TOKEN。
AUTH_ENABLED=false

# Bearer Token（AUTH_ENABLED=true 时必须设置，请使用足够长的随机字符串）
AUTH_TOKEN=

# 控制面板 / 管理接口认证。留空表示沿用 AUTH_ENABLED；
# 建议与 API 使用不同的令牌（DASHBOARD_AUTH_TOKEN 留空则沿用 AUTH_TOKEN）。
DASHBOARD_AUTH_ENABLED=
DASHBOARD_AUTH_TOKEN=

# 仅在完全可信的隔离网络中、明确知道风险时才设为 true：
# 允许「非回环监听 + 未启用认证」启动（不推荐）。
ALLOW_INSECURE_PUBLIC_BIND=false

# ========== CORS 配置 ==========
# 是否启用 CORS 中间件
CORS_ENABLED=true

# 允许跨源调用的浏览器来源（逗号分隔，如 https://app.example.com）。
# 留空 = 不允许任何跨源网页调用；控制面板与 API 同源，不需要配置。
# 非浏览器客户端（SDK / curl / 酒馆等后端）不受 CORS 影响。
# 不推荐使用 *：任何网页都能从你的浏览器跨源调用本服务。
CORS_ORIGINS=

# ========== 浏览器配置 ==========
# Chrome 远程调试端口
BROWSER_PORT=9222

# ========== Dashboard 配置 ==========
DASHBOARD_ENABLED=true
DASHBOARD_FILE=static/index.html

# ========== AI 分析配置 ==========
# 用于「AI 分析页面结构」的辅助模型 API Key（留空则该功能不可用）
HELPER_API_KEY=
HELPER_BASE_URL=http://127.0.0.1:8199/url/gemini.com/v1
# API 提供商类型（auto=自动检测, openai=OpenAI兼容, gemini=Gemini官方, claude=Claude官方）
HELPER_API_PROVIDER=auto
HELPER_MODEL=gemini-3.0-pro
MAX_HTML_CHARS=120000
CANVAS_IMAGE_MAX_SIZE=1024

# ========== 配置文件 ==========
# 站点配置目录：每个站点一个 JSON 文件（R1-2 起取代单文件 config/sites.json）。
# 旧的 SITES_CONFIG_FILE 只作为自动迁移来源：启动时发现该文件会拆分进本目录，并把原文件改名为 .bak。
SITES_CONFIG_DIR=config/sites

# 自定义浏览器路径（可选，留空则自动检测 Chrome/Edge/Brave 等）
# BROWSER_PATH=
# 浏览器配置目录（留空则使用项目内 chrome_profile）
# BROWSER_PROFILE_DIR=
# Chrome 配置名称（常见值：Default、Profile 1）
# BROWSER_PROFILE_NAME=

# 生成媒体链接时使用的对外基础地址（留空则按请求自动推断）
PUBLIC_BASE_URL=

# ===== 代理配置 =====
# 是否启用代理 (true/false)
PROXY_ENABLED=false
# 代理地址 (支持 socks5:// 或 http://)
# 示例: socks5://127.0.0.1:1080 或 http://127.0.0.1:7890
PROXY_ADDRESS=
# 不走代理的地址 (逗号分隔)
PROXY_BYPASS=localhost,127.0.0.1,::1

TOOL_CALLING_RETRY_STRATEGY=focused_repair
TOOL_CALLING_INTERNAL_RETRY_MAX=2
TOOL_CALLING_MAX_TOOL_RESULT_CHARS=300000

# 启动前清理浏览器配置目录中的缓存（true/false）
PROFILE_CLEAN_ENABLED=false

TOOL_CALLING_ALLOW_MEDIA_POSTPROCESS=false
TOOL_CALLING_SANITIZE_ASSISTANT_CONTENT=true

PYTHON_INSTALL_VERSION=3.13.6
TOOL_CALLING_PROMPT_PADDING_OBFUSCATE=false
TOOL_CALLING_PROMPT_PADDING_ENABLED=true

# 允许执行非沙箱 Python 命令（平滑鼠标轨迹、物理点击等需要）。
# 开启后命令里的 Python 代码拥有与本服务相同的系统权限，只在所有命令都来自可信来源时开启。
CMD_ALLOW_UNSAFE_PYTHON_COMMANDS=false

# 定时重启浏览器。空闲标签页的 CDP 会话回收（BROWSER_CDP_RECYCLE_*）已能释放
# 被钉住的旧 DOM / RemoteObject，一般无需再定时重启；需要时再手动开启。
SCHEDULED_RESTART_ENABLED=false
SCHEDULED_RESTART_INTERVAL_SECONDS=10800
SCHEDULED_RESTART_DRAIN_TIMEOUT_SECONDS=1800
SCHEDULED_RESTART_TAB_STATE_POLICY=preserve
TAB_RECOVERY_ENABLED=false
TAB_RECOVERY_MODEL=gpt-4o
TAB_RECOVERY_MAX_ATTEMPTS=1
TAB_RECOVERY_TIMEOUT_SEC=120
TAB_RECOVERY_WORKER_EXIT_WAIT_SEC=600
TAB_RECOVERY_REFRESH_ON_UNKNOWN=true

# ========== 性能 / 内存（详见 docs/performance_refactor.md）==========
# 流式监控页面快照：一次 CDP 调用完成“选元素 + 生成状态 + 提取文本/图片”（默认 true）
STREAM_PAGE_SNAPSHOT_ENABLED=true

# CDP 卫生：run_js 返回的对象/数组 RemoteObject 用完即释放；Network.enable 缓冲区上限（MB，0=不限制）
CDP_HYGIENE_ENABLED=true
CDP_RELEASE_JS_OBJECTS=true
CDP_NETWORK_MAX_TOTAL_BUFFER_MB=32
CDP_NETWORK_MAX_RESOURCE_BUFFER_MB=16

# 空闲标签页冻结（Page.setWebLifecycleState=frozen）：只冻结用户看不到的标签页
# （后台标签 / 最小化窗口），被占用或 page_check 前自动恢复。
# 注意：显式设置 CMD_PERIODIC_KEEPALIVE_ENABLED=true 会让保活周期性唤醒标签页，冻结基本失效。
BROWSER_IDLE_FREEZE_ENABLED=true
BROWSER_IDLE_FREEZE_AFTER_SEC=60
BROWSER_IDLE_FREEZE_REQUIRE_HIDDEN=true

# 空闲标签页 CDP 会话回收：断开并重建 CDP 连接（不刷新页面），释放被钉住的旧 DOM / RemoteObject
BROWSER_CDP_RECYCLE_ENABLED=true
BROWSER_CDP_RECYCLE_IDLE_SEC=30
BROWSER_CDP_RECYCLE_AFTER_REQUESTS=20
BROWSER_CDP_RECYCLE_INTERVAL_SEC=1800
BROWSER_CDP_RECYCLE_DOM_NODES=150000
BROWSER_CDP_RECYCLE_DOM_CHECK_SEC=300

# Chromium 进程模型（可选）：per-site = 同站点标签页共用渲染进程；limit:N = 最多 N 个渲染进程
# 实测省 10%~20% 内存；同一站点并发标签页较多时会互相拖慢，默认留空（Chromium 默认）
BROWSER_PROCESS_MODEL=

# 请求历史落盘去抖（秒）：窗口内的多次更新合并为一次写入，进程退出时自动刷盘
REQUEST_HISTORY_SAVE_DEBOUNCE_SEC=5

# 面板内存统计口径：fast（默认，Windows 用 private / Linux 用 rss-shared，开销极低）| uss（旧口径，开销大）| rss
PANEL_MEMORY_METRIC=fast

# ===== 资源预算与本地媒体访问（审查修复 B3 / S5 / S6）=====
# Responses API 续接历史：单条 / 总量上限（MiB）
RESPONSES_STATE_MAX_ENTRY_MB=8
RESPONSES_STATE_MAX_TOTAL_MB=64
# 定时重启守护代理：最大并发连接数、全局请求缓冲上限（MiB）
RESTART_PROXY_MAX_CONNECTIONS=64
RESTART_PROXY_MAX_BUFFER_MB=256
# /media 与 /download_images 是否需要令牌（AUTH_TOKEN / DASHBOARD_AUTH_TOKEN）或本机直连访问。
# 开启后，第三方聊天前端直接用 <img src> 引用生成媒体将无法加载。
MEDIA_REQUIRE_AUTH=false
# 媒体转码（ffmpeg）：全局并发、排队超时（秒）、源文件上限（MiB）
MEDIA_TRANSCODE_MAX_CONCURRENCY=2
MEDIA_TRANSCODE_QUEUE_TIMEOUT_SEC=10
MEDIA_TRANSCODE_MAX_SOURCE_MB=200
# 标签页 acquire 等待者总量上限（通用/按编号/按域名/按路由组合计），满了立即 503；0 = 不限
TAB_ACQUIRE_MAX_WAITERS=128
