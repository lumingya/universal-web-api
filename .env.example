# ======================================
# Universal Web-to-API 配置文件模板
# ======================================
# 复制为 .env 后按需修改；本模板的默认值即可安全地在本机直接使用。
# 布尔项只接受 true / false（也接受 1/0、yes/no、on/off）。
# 认证开关写成其它值（例如 your-secret-here）会被视为配置错误并拒绝启动。
#
# 本文件由 scripts/build_env_example.py 根据 app/core/settings_registry.py 生成，请勿手改；
# 以 “# 名称=值” 形式出现的是可选项，去掉行首的 # 即可启用，未写出的变量使用内置默认值。

# ========== 版本信息 ==========
# 旧版版本号记录：仅在缺少 VERSION 文件时由更新器读取（实际版本以 VERSION 文件为准）
# （类型: str）
CURRENT_VERSION=1.01

# ========== 更新配置 ==========
# 启用自动更新：开启后 start.bat 会在启动前检查并自动应用更新；关闭后仍会在服务启动后检查新版本，只提示手动更新
# （类型: bool；默认: true）
AUTO_UPDATE_ENABLED=true
# GitHub 仓库：自动更新和启动版本检查使用的仓库，格式为 owner/repo
# （类型: str；默认: lumingya/universal-web-api）
GITHUB_REPO=lumingya/universal-web-api
# 更新时保留的文件/目录（逗号分隔）
# （类型: str）
UPDATE_PRESERVE=chrome_profile,venv,.env.local,logs

# ========== 服务配置 ==========
# 调试模式：开启 API 文档和详细错误
# （类型: bool；默认: false）
APP_DEBUG=false
# 监听地址：127.0.0.1 仅本机（推荐）；0.0.0.0 允许外部访问，此时必须同时启用控制面板认证和服务 API 认证，否则服务拒绝启动
# （类型: str；默认: 127.0.0.1）
APP_HOST=127.0.0.1
# 监听端口
# （类型: int；范围: 1..65535；默认: 8199）
APP_PORT=8199
# 日志级别
# （类型: enum；可选: DEBUG / INFO / WARNING / ERROR；默认: INFO）
LOG_LEVEL=INFO
# 公开访问地址：用于生成返回给客户端的可访问链接，例如图片下载地址
# （类型: str；默认: http://127.0.0.1:8199）
PUBLIC_BASE_URL=

# ========== 认证配置 ==========
# 仅在完全可信的隔离网络中、明确知道风险时才设为 true： 允许「非回环监听 + 未启用认证」启动（不推荐）。
# （类型: bool；默认: false）
ALLOW_INSECURE_PUBLIC_BIND=false
# 启用服务 API 认证：保护 /v1、/url/.../v1、/tab/.../v1 等对外调用接口
# （类型: bool；默认: false）
AUTH_ENABLED=false
# 服务 API Bearer Token：AUTH_ENABLED=true 时必须设置；可提供给项目 API 使用者
# （类型: secret）
AUTH_TOKEN=
# 启用控制面板认证：保护控制面板的配置、日志、命令和标签页管理接口；未设置时兼容沿用服务 API 认证开关
# （类型: bool；默认: false）
DASHBOARD_AUTH_ENABLED=
# 控制面板访问密钥：DASHBOARD_AUTH_ENABLED=true 时必须设置；留空时兼容沿用服务 API Bearer Token
# （类型: secret）
DASHBOARD_AUTH_TOKEN=
# 本机转发代理与服务共享的密钥：只有回环来源且携带匹配密钥时才采信 X-Forwarded-For 等转发头
# （类型: secret）
# UWAPI_PROXY_SECRET=

# ========== CORS 配置 ==========
# 启用 CORS
# （类型: bool；默认: true）
CORS_ENABLED=true
# 允许的跨域源：多个用逗号分隔（如 https://app.example.com）；留空 = 不允许跨源网页调用（控制面板同源无需配置）。不推荐 *
# （类型: str）
CORS_ORIGINS=

# ========== 浏览器与标签页 ==========
# 启动时浏览器里没有已打开的页面，就自动打开各站点的起始页（自重启时不打开）
# （类型: bool；默认: true）
# AUTO_OPEN_BROWSER=true
# 自定义浏览器路径：可选，留空时自动检测 Chrome、Edge、Brave 等浏览器
# （类型: str）
# BROWSER_PATH=
# Chrome 调试端口
# （类型: int；范围: 1024..65535；默认: 9222）
BROWSER_PORT=9222
# 浏览器配置目录：留空时使用项目内的 chrome_profile 目录
# （类型: str）
# BROWSER_PROFILE_DIR=
# 浏览器配置名称：例如 Default、Profile 1
# （类型: str）
# BROWSER_PROFILE_NAME=
# 重连浏览器时主动关闭旧的连接句柄
# （类型: bool；默认: false）
# BROWSER_RECONNECT_QUIT_OLD_HANDLE=false
# 浏览器连接看门狗：近期有活动时的检查间隔（秒）
# （类型: float；范围: 0.5..；默认: 3）
# BROWSER_WATCHDOG_ACTIVE_INTERVAL=3
# 浏览器连接看门狗：空闲时的检查间隔（秒）
# （类型: float；范围: 0.5..；默认: 5）
# BROWSER_WATCHDOG_IDLE_INTERVAL=5
# 多久（秒）以内有请求算“近期有活动”
# （类型: float；范围: 1..；默认: 60）
# BROWSER_WATCHDOG_RECENT_ACTIVITY_WINDOW=60
# 单个请求的最长执行时间（秒）；设置后覆盖 browser_config.json 中的同名常量
# （类型: float；范围: 1..）
# MAX_REQUEST_EXECUTE_TIME_SEC=
# 标签页池上限；设置后覆盖 browser_config.json 的 TAB_POOL_MAX_TABS
# （类型: int；范围: 1..）
# MAX_TABS=
# 标签页池下限；设置后覆盖 browser_config.json 的 TAB_POOL_MIN_TABS
# （类型: int；范围: 0..）
# MIN_TABS=
# 启动时清理浏览器缓存：每次启动脚本时自动清理 ShaderCache、GPUCache 等垃圾缓存，保留登录态和 Cookie
# （类型: bool；默认: false）
PROFILE_CLEAN_ENABLED=false
# 请求超过该时间（秒）仍未结束即判定为僵尸并清理
# （类型: int；范围: 1..；默认: 600）
# REQUEST_ZOMBIE_TTL=600
# 借用标签页执行请求时自动切到前台
# （类型: bool；默认: false）
# TAB_AUTO_ACTIVATE_ON_ACQUIRE=false

# ========== 标签页自动恢复 ==========
# API Key：外部 API 的 Bearer Key，仅在上面的 API 地址非空时使用。
# （类型: secret）
# TAB_RECOVERY_API_KEY=
# API 地址：OpenAI 兼容的 chat/completions 完整地址。⚠️ 填写外部地址后，出错标签页的截图会被发送到该外部服务。留空 = 本地模式：调用本服务自身的 /v1/chat/completions，用池中其他空闲标签页完成判断（自动复用 AUTH_TOKEN）。
# （类型: str）
# TAB_RECOVERY_API_URL=
# 启用 AI 恢复判断：关闭时：旧工作线程退出后直接解除隔离并自动重入池，不截图、不调用任何 AI API。隔离机制本身始终生效。
# （类型: bool；默认: false）
TAB_RECOVERY_ENABLED=false
# 每标签页最大恢复次数：恢复后再次超时即视为不可恢复，永久隔离且不再调用 AI API。设为 0 表示不尝试恢复。
# （类型: int；范围: 0..；默认: 1）
TAB_RECOVERY_MAX_ATTEMPTS=1
# 模型名称：判断使用的模型名，需支持图片输入。
# （类型: str；默认: gpt-4o）
TAB_RECOVERY_MODEL=gpt-4o
# 无法判断时仍尝试刷新：截图、AI 调用或解析失败等「无法判断」的情况：开启=刷新后重入池，关闭=直接永久隔离。
# （类型: bool；默认: true）
TAB_RECOVERY_REFRESH_ON_UNKNOWN=true
# AI 判断超时：本地模式要经过完整浏览器往返，不建议设置过短。
# （类型: int；范围: 1..；默认: 120）
TAB_RECOVERY_TIMEOUT_SEC=120
# 等待旧工作线程退出：超过该时长旧线程仍未退出，则永久隔离该标签页。
# （类型: int；范围: 0..；默认: 600）
TAB_RECOVERY_WORKER_EXIT_WAIT_SEC=600

# ========== 性能与内存（详见 docs/performance_refactor.md） ==========
# 标签页累计处理多少个请求后回收一次 CDP 会话
# （类型: int；范围: 1..；默认: 20）
BROWSER_CDP_RECYCLE_AFTER_REQUESTS=20
# 检查 DOM 节点数的间隔（秒）
# （类型: float；范围: 1..；默认: 300）
BROWSER_CDP_RECYCLE_DOM_CHECK_SEC=300
# 页面 DOM 节点数超过该值时触发回收
# （类型: int；范围: 1..；默认: 150000）
BROWSER_CDP_RECYCLE_DOM_NODES=150000
# 回收空闲标签页的 CDP 会话：断开并重建连接（不刷新页面），释放被钉住的旧 DOM / RemoteObject
# （类型: bool；默认: true）
BROWSER_CDP_RECYCLE_ENABLED=true
# 标签页空闲多久（秒）后才允许回收 CDP 会话
# （类型: float；范围: 0..；默认: 30）
BROWSER_CDP_RECYCLE_IDLE_SEC=30
# 定期回收 CDP 会话的间隔（秒）
# （类型: float；范围: 1..；默认: 1800）
BROWSER_CDP_RECYCLE_INTERVAL_SEC=1800
# 标签页空闲多久（秒）后冻结
# （类型: float；范围: 0..；默认: 60）
BROWSER_IDLE_FREEZE_AFTER_SEC=60
# 冻结空闲标签页（Page.setWebLifecycleState=frozen），被占用或页面检查前自动恢复；显式开启周期保活会让冻结基本失效
# （类型: bool；默认: true）
BROWSER_IDLE_FREEZE_ENABLED=true
# 只冻结用户看不到的标签页（后台标签或最小化窗口）
# （类型: bool；默认: true）
BROWSER_IDLE_FREEZE_REQUIRE_HIDDEN=true
# 标签页空闲多久（秒）后才参与内存清理
# （类型: float；范围: 0..；默认: 300）
# BROWSER_IDLE_MEMORY_PURGE_AFTER_SEC=300
# 空闲时定期清理浏览器内存（不影响正在执行的工作流）
# （类型: bool；默认: true）
# BROWSER_IDLE_MEMORY_PURGE_ENABLED=true
# 内存清理的检查间隔（秒）
# （类型: float；范围: 1..；默认: 180）
# BROWSER_IDLE_MEMORY_PURGE_INTERVAL_SEC=180
# 省内存模式：不再周期性唤醒后台标签页（页面检查与真实工作流仍按需唤醒）
# （类型: bool；默认: false）
# BROWSER_MEMORY_SAVER=false
# Chromium 进程模型（可选）：per-site = 同站点标签页共用渲染进程；limit:N = 最多 N 个渲染进程 实测省 10%~20% 内存；同一站点并发标签页较多时会互相拖慢，默认留空（Chromium 默认）
# （类型: str）
BROWSER_PROCESS_MODEL=
# CDP 卫生总开关：释放用完的 RemoteObject，并限制 Network 缓冲区（详见 docs/performance_refactor.md）
# （类型: bool；默认: true）
CDP_HYGIENE_ENABLED=true
# Network.enable 的单个资源缓冲区上限（MB，0 = 不限制）
# （类型: float；范围: 0..；默认: 16）
CDP_NETWORK_MAX_RESOURCE_BUFFER_MB=16
# Network.enable 的总缓冲区上限（MB，0 = 不限制）
# （类型: float；范围: 0..；默认: 32）
CDP_NETWORK_MAX_TOTAL_BUFFER_MB=32
# run_js 返回的对象/数组 RemoteObject 用完即释放
# （类型: bool；默认: true）
CDP_RELEASE_JS_OBJECTS=true
# 面板内存统计口径：fast（默认，开销极低；Windows 用 private，Linux 用 rss-shared）、uss（旧口径，开销大）、rss
# （类型: enum；可选: fast / uss / rss；默认: fast）
PANEL_MEMORY_METRIC=fast
# 请求历史落盘去抖（秒）：窗口内的多次更新合并为一次写入，进程退出时自动刷盘
# （类型: int；默认: 5）
REQUEST_HISTORY_SAVE_DEBOUNCE_SEC=5
# 流式监控页面快照：一次 CDP 调用完成“选元素 + 生成状态 + 提取文本/图片”（默认 true）
# （类型: bool；默认: true）
STREAM_PAGE_SNAPSHOT_ENABLED=true

# ========== 代理配置 ==========
# 代理地址：支持 socks5://、http:// 或 https://；Python 下载会通过 SOCKS 代理解析域名
# （类型: str；默认: socks5://127.0.0.1:1080）
PROXY_ADDRESS=
# 绕过代理：浏览器和 Python 下载均不走代理的地址，多个用逗号分隔
# （类型: str；默认: localhost,127.0.0.1）
PROXY_BYPASS=localhost,127.0.0.1,::1
# 启用代理：开启后浏览器和 Python 后端的远程资源下载将共用该代理
# （类型: bool；默认: false）
PROXY_ENABLED=false

# ========== Dashboard 配置 ==========
# 启用 Dashboard
# （类型: bool；默认: true）
DASHBOARD_ENABLED=true
# Dashboard 文件路径
# （类型: str；默认: static/index.html）
DASHBOARD_FILE=static/index.html
# 调试模式：开启调试接口与更详细的日志
# （类型: bool；默认: false）
# DEBUG=false

# ========== 服务守护 ==========
# 定时重启守护代理的全局请求缓冲上限（MiB）
# （类型: float；范围: 1..；默认: 256）
RESTART_PROXY_MAX_BUFFER_MB=256
# 定时重启守护代理的最大并发连接数
# （类型: int；范围: 1..；默认: 64）
RESTART_PROXY_MAX_CONNECTIONS=64
# 最长排空等待：到期后仍有工作流时的最大等待时间。超时后本轮不重启，以免中断工作流，并在下一周期重试。
# （类型: int；范围: 0..；默认: 1800）
SCHEDULED_RESTART_DRAIN_TIMEOUT_SECONDS=1800
# 启用定时后端重启：开启后由启动器保持对外端口；后端重启期间进入的新请求会等待新实例就绪后继续执行。
# （类型: bool；默认: false）
SCHEDULED_RESTART_ENABLED=false
# 重启间隔：默认 10800 秒（3 小时）。每次成功重启后重新计时。
# （类型: int；范围: 300..；默认: 10800）
SCHEDULED_RESTART_INTERVAL_SECONDS=10800
# 标签页状态策略：当前仅支持 preserve：不关闭浏览器，也不清理标签页。该独立设置为后续加入标签页状态清理策略预留。
# （类型: enum；可选: preserve；默认: preserve）
SCHEDULED_RESTART_TAB_STATE_POLICY=preserve

# ========== AI 分析配置 ==========
# Canvas 图片最大边长：浏览器内下载 URL 图片时，Canvas 压缩后的最长边。默认 1024；调大可保留更多细节，但会增加返回体和内存占用。
# （类型: int；范围: 1..；默认: 1024）
CANVAS_IMAGE_MAX_SIZE=1024
# API Key
# （类型: secret）
HELPER_API_KEY=
# API 提供商：支持 auto、openai、gemini、claude
# （类型: enum；可选: auto / openai / gemini / claude；默认: auto）
HELPER_API_PROVIDER=auto
# API 地址：留空则不启用外部辅助 AI。示例：http://127.0.0.1:8199/url/gemini.com/v1
# （类型: str）
HELPER_BASE_URL=http://127.0.0.1:8199/url/gemini.com/v1
# 模型名称
# （类型: str；默认: gpt-4）
HELPER_MODEL=gemini-3.0-pro
# HTML 最大字符数：超过会截断以节省 Token
# （类型: int；范围: 10000..；默认: 120000）
MAX_HTML_CHARS=120000

# ========== 函数调用 ==========
# 允许媒体后处理：开启后，函数调用隐藏回合也会执行媒体二次提取、占位补偿和 Markdown 媒体注入。兼容旧行为，但更容易污染 tool payload；默认关闭。
# （类型: bool；默认: false）
TOOL_CALLING_ALLOW_MEDIA_POSTPROCESS=false
# 部分工具调用校验失败时，仍返回通过校验的调用
# （类型: bool；默认: true）
# TOOL_CALLING_ALLOW_PARTIAL_SUCCESS=true
# 工具调用重试仍失败时降级为普通文本回复
# （类型: bool；默认: false）
# TOOL_CALLING_DEGRADE_ON_FAILURE=false
# 内部修复重试次数：函数调用结果校验失败时，自动修复后再次重试的次数。0 表示关闭自动修复；默认 2；最大 5。
# （类型: int；范围: 0..5；默认: 2）
TOOL_CALLING_INTERNAL_RETRY_MAX=2
# 单个工具调用参数的最大字符数
# （类型: int；范围: 256..500000；默认: 50000）
# TOOL_CALLING_MAX_ARGUMENT_CHARS=50000
# 工具调用参数 JSON 的最大嵌套深度
# （类型: int；范围: 2..100；默认: 20）
# TOOL_CALLING_MAX_ARGUMENT_DEPTH=20
# 工具调用参数 JSON 的最大节点数
# （类型: int；范围: 16..50000；默认: 4000）
# TOOL_CALLING_MAX_ARGUMENT_NODES=4000
# 单条 Tool Result 上限：单条函数调用结果超过此字符数时，后端会直接返回明确错误，避免把超大结果继续塞给网页模型。默认 300000，可按需要调大。
# （类型: int；范围: 1..；默认: 300000）
TOOL_CALLING_MAX_TOOL_RESULT_CHARS=300000
# 注入预填充/尾部提示词：开启后，会继续注入函数调用的预填充与尾部提示词；关闭后仅保留重试策略相关提示词。默认开启。
# （类型: bool；默认: true）
TOOL_CALLING_PROMPT_PADDING_ENABLED=true
# 预填充乱序零宽：开启后，函数调用的预填充和尾部提示词会随机乱序，并插入少量零宽字符。仅影响额外 padding，不改动工具定义；默认关闭。
# （类型: bool；默认: false）
TOOL_CALLING_PROMPT_PADDING_OBFUSCATE=false
# 日志与错误信息中被拒参数的预览长度
# （类型: int；范围: 0..；默认: 500）
# TOOL_CALLING_REJECTED_ARGUMENT_PREVIEW_CHARS=500
# 重试策略：聚焦修复只发送必要的修复信息；完整上下文会把原对话和修复反馈一起发给模型。
# （类型: enum；可选: focused_repair / full_context；默认: focused_repair）
TOOL_CALLING_RETRY_STRATEGY=focused_repair
# 解析前清洗回复：开启后，函数调用在解析 assistant 内容前会移除占位链接和尾部媒体 Markdown。推荐保持开启；只有需要完全回退旧行为时再关闭。
# （类型: bool；默认: true）
TOOL_CALLING_SANITIZE_ASSISTANT_CONTENT=true

# ========== 命令系统 ==========
# 执行命令时把目标标签页切到前台
# （类型: bool；默认: false）
# CMD_ACTIVATE_TAB_ON_COMMAND=false
# “追加写文件”命令允许写入的根目录；留空使用默认目录
# （类型: str）
# CMD_APPEND_FILE_BASE_DIR=
# 异步命令的最大并发线程数
# （类型: int；范围: 1..；默认: 20）
# CMD_ASYNC_MAX_WORKERS=20
# 导入模块时就启动命令调度器（默认由应用生命周期负责启动和停止，仅嵌入/调试时使用）
# （类型: bool；默认: false）
# CMD_ENGINE_AUTO_START=false
# 命令里“执行工作流”步骤的默认超时（秒）
# （类型: float；范围: 1..；默认: 45）
# CMD_EXECUTE_WORKFLOW_TIMEOUT_SEC=45
# 页面检查失败后的退避时间（秒）
# （类型: float；范围: 0..；默认: 30）
# CMD_PAGE_CHECK_FAILURE_BACKOFF_SEC=30
# 页面检查脚本的超时（秒）；留空使用后台唤醒脚本的内置超时
# （类型: float；范围: 0.1..）
# CMD_PAGE_CHECK_JS_TIMEOUT_SEC=
# 页面刷新后多久（秒）内不做页面检查
# （类型: float；范围: 0..；默认: 2）
# CMD_PAGE_CHECK_REFRESH_GRACE_SEC=2
# 周期性保活后台标签页；留空时自动决定（开启省内存或空闲冻结时默认关闭，否则开启）
# （类型: bool）
# CMD_PERIODIC_KEEPALIVE_ENABLED=
# 周期保活的间隔（秒）
# （类型: float；范围: 1..；默认: 20）
# CMD_PERIODIC_KEEPALIVE_INTERVAL_SEC=20
# 周期性输出命令引擎摘要日志
# （类型: bool；默认: false）
# CMD_PERIODIC_SUMMARY_LOG_ENABLED=false
# Python 命令沙箱额外允许导入的模块（逗号分隔）
# （类型: str）
# CMD_PYTHON_SANDBOX_ALLOWED_IMPORTS=
# Python 命令沙箱是否允许使用 requests 发起网络请求
# （类型: bool；默认: true）
# CMD_PYTHON_SANDBOX_ALLOW_REQUESTS=true
# 命令触发的请求的基准优先级
# （类型: int；默认: 2）
# CMD_REQUEST_PRIORITY_BASELINE=2
# 命令引擎定期刷新标签页池
# （类型: bool；默认: true）
# CMD_TAB_POOL_AUTO_REFRESH=true
# 标签页池刷新间隔（秒）
# （类型: float；范围: 0.5..；默认: 5）
# CMD_TAB_POOL_REFRESH_INTERVAL_SEC=5
# 执行命令时启用焦点模拟（不切前台也让页面认为自己处于焦点）
# （类型: bool；默认: true）
# CMD_USE_FOCUS_EMULATION_ON_COMMAND=true
# 页面检查前先唤醒后台标签页
# （类型: bool；默认: true）
# CMD_WAKE_TAB_BEFORE_PAGE_CHECK=true
# 同一标签页两次唤醒的最小间隔（秒）
# （类型: float；范围: 0..；默认: 2）
# CMD_WAKE_TAB_MIN_INTERVAL_SEC=2

# ========== Arena 与代理轮换 ==========
# 事件桥接文件保留的轮转备份数
# （类型: int；范围: 1..；默认: 2）
# ARENA_EVENT_BRIDGE_BACKUPS=2
# 传给命令的结果文本最大字符数
# （类型: int；范围: 0..；默认: 60000）
# ARENA_EVENT_BRIDGE_COMMAND_TEXT_LIMIT=60000
# 事件去重缓存的最大条目数
# （类型: int；范围: 1..；默认: 4096）
# ARENA_EVENT_BRIDGE_DEDUPE_MAX_ENTRIES=4096
# 回复完成前是否也写出中间结果
# （类型: bool；默认: false）
# ARENA_EVENT_BRIDGE_EMIT_PARTIAL=false
# 把 Arena 结果写入事件桥接文件，供外部程序或命令读取
# （类型: bool；默认: true）
# ARENA_EVENT_BRIDGE_ENABLED=true
# 事件桥接文件达到该大小（字节，最小 1MB）后轮转
# （类型: int；范围: 1048576..；默认: 52428800）
# ARENA_EVENT_BRIDGE_MAX_BYTES=52428800
# 事件桥接文件路径；留空使用默认位置
# （类型: str）
# ARENA_EVENT_BRIDGE_PATH=
# 写出事件后是否触发匹配的命令
# （类型: bool；默认: true）
# ARENA_EVENT_BRIDGE_TRIGGER_COMMANDS=true
# Arena 模型列表缓存文件；留空为 scripts/arena_models_cache.json
# （类型: str）
# ARENA_MODELS_CACHE_PATH=
# Arena 模型别名本地覆盖文件；留空为 config/arena_model_aliases.local.json
# （类型: str）
# ARENA_MODEL_ALIAS_OVERRIDES_PATH=
# Arena 模型目录本地配置文件；留空为 config/arena_model_catalog.local.json
# （类型: str）
# ARENA_MODEL_CATALOG_CONFIG_PATH=
# 事件桥接使用的模型名映射文件路径（可选）
# （类型: str）
# ARENA_MODEL_MAP_PATH=
# Arena 代理轮换使用的 Clash 外部控制器地址
# （类型: str；默认: http://127.0.0.1:9097；旧名: ARENA_CLASH_API）
# CLASH_API=http://127.0.0.1:9097
# 参与轮换的节点名单：JSON 数组或逗号分隔；留空使用内置默认名单
# （类型: str；旧名: ARENA_PROXY_POOL）
# CLASH_PROXY_POOL=
# Clash 外部控制器密钥
# （类型: secret；旧名: ARENA_CLASH_SECRET）
# CLASH_SECRET=
# Clash 中用于切换节点的策略组名称
# （类型: str；默认: 主代理；旧名: ARENA_CLASH_SELECTOR）
# CLASH_SELECTOR=主代理

# ========== 资源预算与本地媒体访问 ==========
# /media 与 /download_images 是否需要令牌（AUTH_TOKEN / DASHBOARD_AUTH_TOKEN）或本机直连访问。 开启后，第三方聊天前端直接用 <img src> 引用生成媒体将无法加载。
# （类型: bool；默认: false）
MEDIA_REQUIRE_AUTH=false
# 媒体转码（ffmpeg）的全局并发上限
# （类型: int；范围: 1..；默认: 2）
MEDIA_TRANSCODE_MAX_CONCURRENCY=2
# 源文件超过该大小（MiB）时拒绝转码
# （类型: float；范围: 1..；默认: 200）
MEDIA_TRANSCODE_MAX_SOURCE_MB=200
# 媒体转码排队超过该时间（秒）返回 503
# （类型: float；范围: 0..；默认: 10）
MEDIA_TRANSCODE_QUEUE_TIMEOUT_SEC=10
# Responses API 续接历史：单条上限（MiB）
# （类型: float；范围: 0..；默认: 8）
RESPONSES_STATE_MAX_ENTRY_MB=8
# Responses API 续接历史：总量上限（MiB）
# （类型: float；范围: 0..；默认: 64）
RESPONSES_STATE_MAX_TOTAL_MB=64
# 标签页 acquire 等待者总量上限（通用/按编号/按域名/按路由组合计），满了立即 503；0 = 不限
# （类型: int；默认: 128）
TAB_ACQUIRE_MAX_WAITERS=128

# ========== 配置文件路径 ==========
# 命令配置文件；留空为 config/commands.json
# （类型: str）
# COMMANDS_CONFIG_FILE=
# 命令本地覆盖文件；留空为 config/commands.local.json
# （类型: str）
# COMMANDS_LOCAL_FILE=
# 文件粘贴转 PDF 时使用的中文字体；留空自动查找
# （类型: str）
# FILE_PASTE_PDF_FONT_PATH=
# 解析器配置文件；留空为 config/parsers.json
# （类型: str）
# PARSERS_CONFIG_FILE=
# 粘贴产生的临时文件至少保留多久（秒）才清理
# （类型: float；范围: 0..；默认: 900）
# PASTE_TEMP_CLEANUP_MIN_AGE_SECONDS=900
# 运行时数据库（请求历史、累计统计，SQLite）；留空为 config/runtime.sqlite3
# （类型: str）
# RUNTIME_DB_PATH=
# 站点配置目录（每站点一个文件）
# （类型: str；默认: config/sites）
SITES_CONFIG_DIR=config/sites
# 旧版单文件站点配置，仅作为自动迁移来源；留空为 config/sites.json
# （类型: str）
# SITES_CONFIG_FILE=
# 站点本地覆盖文件；留空为 config/sites.local.json
# （类型: str）
# SITES_LOCAL_FILE=
# 站点规则文件；留空为 config/site_rules.json
# （类型: str）
# SITE_RULES_FILE=
# 其他临时文件至少保留多久（秒）才清理
# （类型: float；范围: 0..；默认: 3600）
# TEMP_CLEANUP_MIN_AGE_SECONDS=3600

# ========== 日志 ==========
# 日志轮转保留的备份数
# （类型: int；范围: 1..；默认: 5）
# LOG_BACKUP_COUNT=5
# 日志目录；留空为项目下的 logs/
# （类型: str）
# LOG_DIR=
# 日志文件路径；留空为日志目录下的默认文件
# （类型: str）
# LOG_FILE=
# 单个日志文件达到该大小（字节）后轮转
# （类型: int；范围: 1..；默认: 5242880）
# LOG_MAX_BYTES=5242880

# ========== 启动器与进程 ==========
# 启动器安装依赖时使用的 pip 镜像地址；留空使用内置默认镜像
# （类型: str）
# PIP_MIRROR_URL=
# 启动器自动安装 Python 时使用的版本
# （类型: str；默认: 3.13.6）
PYTHON_INSTALL_VERSION=3.13.6
# 进程模型（实验性）：inproc 为单进程（默认）；process 为 API 进程与持有浏览器的 worker 进程分离，worker 由 API 进程自动启动
# （类型: enum；可选: inproc / process；默认: inproc）
# UWAPI_WORKER_MODE=inproc
# （内部）进程角色，worker 进程由 API 进程启动时设为 worker，请勿手动设置
# （类型: str）
# UWAPI_WORKER_ROLE=
# （内部）worker 地址；留空时由 API 进程启动 worker 后自动设置
# （类型: str）
# UWAPI_WORKER_URL=
# （内部）API 进程与 worker 之间的鉴权令牌，启动时自动生成
# （类型: secret）
# UWAPI_WORKER_TOKEN=
# worker 监听的本机端口；0 表示自动选择空闲端口
# （类型: int；范围: 0..65535；默认: 0）
# UWAPI_WORKER_PORT=0
# 为 true 时 .env 中的值覆盖进程里已有的同名环境变量
# （类型: bool；默认: false）
# UWAPI_DOTENV_OVERRIDE=false
# （内部）启动器传给服务进程的实际监听地址，供启动安全检查使用
# （类型: str）
# UWAPI_PUBLIC_BIND_HOST=

# ========== 高危开关 ==========
# 允许非沙箱 Python 命令：⚠️ 高危：开启后命令引擎会跳过 Python 脚本安全校验，以完整 __builtins__ 执行任意脚本（可读写文件、发起网络请求、执行系统命令）。仅在站点配置完全可信、且确实需要平滑鼠标轨迹/物理点击时开启。默认关闭。
# （类型: bool；默认: false）
CMD_ALLOW_UNSAFE_PYTHON_COMMANDS=false
# 允许从控制面板安装第三方解析器代码（安全开关，默认关闭）
# （类型: bool；默认: false）
# PARSER_INSTALL_ENABLED=false
