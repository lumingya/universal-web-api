            "optional": false,
            "value": null
          },
          {
            "action": "KEY_PRESS",
            "target": "Enter",
            "optional": true,
            "value": null
          },
          {
            "action": "STREAM_WAIT",
            "target": "result_container",
            "optional": false,
            "value": null
          }
        ],
        "stealth": false,
        "stream_config": {
          "mode": "network",
          "hard_timeout": 300,
          "network": {
            "listen_pattern": "api/v2/chat/completions",
            "stream_match_mode": "keyword",
            "stream_match_pattern": "",
