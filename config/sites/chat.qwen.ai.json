        },
        "workflow": [
          {
            "action": "CLICK",
            "target": "new_chat_btn",
            "optional": true,
            "value": null
          },
          {
            "action": "WAIT",
            "target": "",
            "optional": false,
            "value": "0.5"
          },
          {
            "action": "FILL_INPUT",
